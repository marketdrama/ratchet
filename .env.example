NEXT_PUBLIC_RPC_URL=http://127.0.0.1:18999
NEXT_PUBLIC_SOLANA_CLUSTER=localnet
# Set true only after reviewed mainnet deployment, bytecode verification and authority setup.
NEXT_PUBLIC_ENABLE_MAINNET_TRADING=false
# For public read-only preview: NEXT_PUBLIC_RPC_URL=/api/solana and cluster=mainnet-beta.
# Configure RPC_URL privately on the server; never expose authenticated URLs in NEXT_PUBLIC_* / VITE_*.
# Use node --env-file=.env.operations to load local operations credentials.
